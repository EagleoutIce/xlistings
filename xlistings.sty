% Color & Style Definitions
\if@xlst@print
\definecolor{xlst@colors@border}{HTML}{DDDFE2}
\definecolor{xlst@colors@background}{HTML}{FFFFFF}% save ink :D
\else
\definecolor{xlst@colors@border}{HTML}{E4E8EF}
\definecolor{xlst@colors@background}{HTML}{FAFBFD}
\fi

% default palette
% The colors share one perceived lightness (OKLCH L about .54), keywordB and
% keywordC are a lighter and a darker step of keywordA.
\definecolor{xlst@colors@lst@keywordA}{RGB}{177,48,101} % e.g.: class, public, static...
\definecolor{xlst@colors@lst@keywordB}{RGB}{193,88,125} % e.g.: int, double ...
\definecolor{xlst@colors@lst@keywordC}{RGB}{143,32,79} % e.g.: class-names?
\definecolor{xlst@colors@lst@numbers}{RGB}{0,127,138} % well, numbers
\definecolor{xlst@colors@lst@numprefix}{RGB}{110,120,145} % the '0x' of '0x2a'
\definecolor{xlst@colors@lst@literals}{RGB}{173,92,21} % strings and friends
\definecolor{xlst@colors@lst@comments}{RGB}{112,122,142} % well, comments
\definecolor{xlst@colors@lst@highlight}{RGB}{37,131,67} % sweetspots
\colorlet{xlst@colors@lst@command}{xlst@colors@lst@keywordB} % sweetspots
\definecolor{xlst@colors@lst@linenumbers}{RGB}{152,162,179}

% define the styling definitions
% as we don't know, if 'foreach' is available, we will built our own iter:
